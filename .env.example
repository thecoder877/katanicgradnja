# Public environment variables
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quote form delivery (optional until launch)
# POST JSON payload when a valid inquiry is submitted.
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_TOKEN=

# Supabase (admin panel + project gallery)
# Use the publishable/anon key only. Never put a service_role or sb_secret_ key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback if a legacy anon key is used instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional comma-separated allowlist. If empty, any authenticated user can access /admin.
# ADMIN_EMAILS=stefan@example.com
